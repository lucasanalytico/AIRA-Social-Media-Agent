{% extends "_base.html.j2" %}
{% block slide %}
<div class="slide">
  <div style="position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(3,152,158,0.10) 0%,transparent 70%);bottom:-200px;right:-150px;pointer-events:none;"></div>
  <div class="topbar">
    <span class="dot"></span>
    <span>{{ trend_name }}</span>
  </div>

  <div class="hook">
    <h1>{{ hook_text }}<span class="accent">?</span></h1>
  </div>

  <div class="wordmark">
    <span class="brand-name">Analytico Training Academy</span>
    <span class="swipe-indicator">SWIPE →</span>
  </div>
</div>
{% endblock %}
