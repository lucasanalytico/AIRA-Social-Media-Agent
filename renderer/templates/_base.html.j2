<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800;900&display=swap" rel="stylesheet">
<style>
  :root {
    --brand: #03989e;
    --brand-dark: #02787d;
    --brand-light: #5fcacf;
    --ink: #0a1f21;
    --bg: #ffffff;
    --paper: #f6f7f7;
    --line: #d8dcdd;
    --muted: #6b7778;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1080px; overflow: hidden; }
  body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  .slide {
    position: relative;
    width: 1080px;
    height: 1080px;
    padding: 90px 96px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Top brand bar */
  .topbar {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--brand);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .topbar .dot {
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--brand);
    display: inline-block;
  }

  /* Bottom wordmark */
  .wordmark {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--muted);
    font-size: 18px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .wordmark .brand-name {
    color: var(--brand);
    font-weight: 700;
  }

  /* Hook headline (slide 1) */
  .hook {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  .hook h1 {
    font-weight: 900;
    font-size: 92px;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    max-width: 880px;
  }
  .hook h1 .accent { color: var(--brand); }

  /* Swipe indicator (slide 1 bottom-right) */
  .swipe-indicator {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--brand);
    color: #ffffff;
    padding: 14px 24px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.18em;
  }

  /* Reveal layout (slide 2) */
  .reveal-headline {
    font-weight: 900;
    font-size: 76px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 60px;
    max-width: 880px;
  }
  .reveal-headline .accent { color: var(--brand); }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 8px;
  }
  .stat-row {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    padding: 26px 28px;
    background: var(--paper);
    border-left: 6px solid var(--brand);
    border-radius: 10px;
  }
  .stat-row .num {
    color: var(--brand);
    font-weight: 800;
    font-size: 38px;
    line-height: 1;
    min-width: 56px;
  }
  .stat-row .text {
    font-weight: 500;
    font-size: 30px;
    line-height: 1.3;
    color: var(--ink);
    flex: 1;
  }
  .stat-row .text strong { font-weight: 800; color: var(--brand-dark); }

  /* CTA pill (slide 2 footer area) */
  .cta-pill {
    display: inline-block;
    background: var(--ink);
    color: #ffffff;
    padding: 16px 28px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 22px;
    letter-spacing: 0.02em;
    margin-top: 36px;
  }
</style>
</head>
<body>
{% block slide %}{% endblock %}
</body>
</html>
